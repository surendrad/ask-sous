# Secrets
.env
.env.*.local
*service-account*.json
*credentials*.json
*.key.json

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
build/
coverage/

# OS
.DS_Store

# Local tool state (not project source) — but project-level skills under
# .claude/skills/ are shared, versioned project source (see setup/SKILL.md),
# so they're carved out of this ignore rule rather than excluded wholesale.
.claude/*
!.claude/skills/
!.claude/skills/**
