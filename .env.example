# Ask Sous — environment configuration
# Copy to `.env` and fill in real values. `.env` is gitignored; only this
# example file (with placeholders) is committed.

# --- Database (admin/migration credentials) ---
# Must stay consistent with POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below —
# docker-compose.yml uses those three to initialise the Postgres container,
# while DATABASE_URL is what the app and Alembic actually connect with.
DATABASE_URL=postgresql+asyncpg://ask_sous:changeme@localhost:5432/ask_sous
POSTGRES_USER=ask_sous
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ask_sous

# --- Read-only role (dedicated credentials for the agent's DB tools, from Phase 2 onward) ---
# Never the same credentials as DATABASE_URL above — see CLAUDE.md's read-only
# DB boundary and docs/decisions/002-readonly-postgres-role.md.
READONLY_DB_PASSWORD=changeme-readonly

# --- Google Cloud / Vertex AI ---
# See docs/reference/gcp-setup.md for the one-time manual setup checklist.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# --- Feature flags ---
# Optional background trickle-inserter (Phase 7). Defaults to off.
ENABLE_TRICKLE=false
